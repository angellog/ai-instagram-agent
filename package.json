{
  "name": "ai-instagram-agent",
  "version": "0.1.0",
  "description": "Autonomous AI Instagram persona: conversation, memory, content, carousels, publishing, analytics",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "start:web": "ROLE=web node dist/main.js",
    "start:worker": "ROLE=worker node dist/main.js",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:prod": "node dist/db/migrate.js",
    "cli": "tsx src/cli.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@fastify/formbody": "^9.0.0",
    "@resvg/resvg-js": "^2.6.2",
    "bullmq": "^6.3.8",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "sharp": "^0.35.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.1.3",
    "railway": "^3.11.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
