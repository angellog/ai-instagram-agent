# ai-instagram-agent environment. Copy to .env for local development.
# Behavioural settings (mode, limits, budgets) are NOT here: they live in the
# `controls` table and are edited from /admin/controls without a deploy.

# --- runtime ---------------------------------------------------------------
NODE_ENV=development            # production on Railway
ROLE=all                        # web | worker | all
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# --- data ------------------------------------------------------------------
DATABASE_URL=postgresql://localhost:5432/aia_dev
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=aia

# --- security (required in production) ------------------------------------
ADMIN_TOKEN=                    # openssl rand -hex 24  (dashboard + /api login)
ENCRYPTION_KEY=                 # openssl rand -hex 32  (encrypts stored IG tokens)

# --- Instagram (Instagram API with Instagram Login) -----------------------
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=           # verifies direct Meta webhooks + OAuth
FACEBOOK_APP_SECRET=            # optional; some app types sign with this one
WEBHOOK_VERIFY_TOKEN=           # only if Meta points straight at this service
INSTAGRAM_ACCOUNT_ID=           # the persona account's IG user id (seed)
INSTAGRAM_ACCESS_TOKEN=         # its long-lived token (seed; refreshed automatically)

# --- OpenReply relay (OpenReply owns the Meta webhook URL) ---------------
OPENREPLY_RELAY_SECRET=         # same value as OpenReply's AGENT_RELAY_SECRET
OPENREPLY_DEFER_KEYWORDS=LINK   # campaign keywords OpenReply already answers

# --- LLM -------------------------------------------------------------------
LLM_PROVIDER=anthropic          # anthropic | openai_compatible | mock
LLM_API_KEY=
LLM_BASE_URL=                   # required for openai_compatible (e.g. https://openrouter.ai/api/v1)
LLM_MODEL=claude-sonnet-5
LLM_FAST_MODEL=claude-haiku-4-5-20251001

# --- kie.ai image generation ----------------------------------------------
KIE_API_KEY=
KIE_API_KEY_2=                  # optional failover keys (used on 402)
KIE_API_KEY_3=
KIE_IMAGE_MODEL=nano-banana-pro
KIE_USD_PER_CREDIT=0.005
MOCK_IMAGES=false               # true = offline placeholder images

# --- media hosting (Supabase first, imgbb fallback) -----------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=ai-agent-media
IMGBB_API_KEY=

# --- optional operator notifications ---------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- persona ---------------------------------------------------------------
PERSONA_PATH=config/persona.yaml
KNOWLEDGE_PATH=config/knowledge.yaml
CONTENT_PLAN_CRON=20 8,12,16,19 * * *   # persona local time; the director may still decide to wait
